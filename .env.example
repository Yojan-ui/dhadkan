# Copy to .env (git-ignored) and fill in. Nothing here is required: without keys, alerts are logged as dry runs.

# Meta WhatsApp Cloud API (developers.facebook.com > WhatsApp > API setup; the free test number works)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# Optional: an approved message template with one body variable {{1}}; leave empty to send plain text
# (plain text only reaches a number that has messaged the business number in the last 24 hours)
WA_TEMPLATE=
# Webhook: Meta calls GET /webhooks/whatsapp with this token, and signs POSTs with the app secret
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Twilio: WhatsApp sandbox fallback and SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
TWILIO_SMS_FROM=

# Public URL of this server (e.g. a tunnel), for webhooks and for Twilio to fetch the audio/image
PUBLIC_BASE_URL=

# Who gets alerts. Only these numbers are ever messaged; data/sim/cluster.json numbers are made up.
DHADKAN_PHONE_A=
DHADKAN_PHONE_B=
DHADKAN_PHONE_C=
DHADKAN_SUPERVISOR_A=
DHADKAN_SUPERVISOR_B=
DHADKAN_SUPERVISOR_C=
# Demo mode: the judge's number (can also be typed in the dashboard)
DHADKAN_DEMO_TO=

# 1 = build and log every message but send nothing, even with keys set (rehearsals, recordings)
DHADKAN_DRY_RUN=

# WhatsApp language per factory: hi, mr, gu, en or hi_latn (Hindi in Roman script). Default: the factory's.
DHADKAN_LANG_A=
DHADKAN_LANG_B=
DHADKAN_LANG_C=

# 1 = send approved templates alert_watch / alert_repair / alert_stop / daily_digest (docs/WHATSAPP_TEMPLATES.md)
WA_TEMPLATES=

# The factory's own mechanic (gets the WhatsApp job after the owner replies 1) and its language
DHADKAN_MECHANIC_A=
DHADKAN_MECHANIC_B=
DHADKAN_MECHANIC_C=
DHADKAN_LANG_MECHANIC_A=

# Real WhatsApp flow (server/whatsapp.py, server/wa_agent.py, server/factory/flow.py) via the Twilio sandbox.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=whatsapp:+17372508034
OWNER_PHONE=whatsapp:+91XXXXXXXXXX
# npm run demo opens an ngrok tunnel and sets PUBLIC_BASE_URL when this is set.
NGROK_AUTHTOKEN=
# Template first: Twilio trial senders refuse free text (21654). The template's ContentSid (HX...) from the
# Try WhatsApp page, and its variables: {short} = short alert, {time} = now. The full alert follows as the
# reply when the person answers. TWILIO_TEMPLATE_FIRST=1 skips the free-text attempt.
TWILIO_CONTENT_SID=
TWILIO_CONTENT_VARS={"1": "{short}", "2": "{time}"}
TWILIO_TEMPLATE_FIRST=
