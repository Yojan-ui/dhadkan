# Copy to .env (git-ignored) and fill in. Nothing here is required: without keys, alerts are logged as dry runs.

# Meta WhatsApp Cloud API (developers.facebook.com > WhatsApp > API setup; the free test number works)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# Optional: an approved message template with one body variable {{1}}; leave empty to send plain text
# (plain text only reaches a number that has messaged the business number in the last 24 hours)
WA_TEMPLATE=
# Webhook: Meta calls GET /webhooks/whatsapp with this token, and signs POSTs with the app secret
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Twilio: WhatsApp sandbox fallback and SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
TWILIO_SMS_FROM=

# Public URL of this server (e.g. a tunnel), for webhooks and for Twilio to fetch the audio/image
PUBLIC_BASE_URL=

# Who gets alerts. Only these numbers are ever messaged; data/sim/cluster.json numbers are made up.
DHADKAN_PHONE_A=
DHADKAN_PHONE_B=
DHADKAN_PHONE_C=
DHADKAN_SUPERVISOR_A=
DHADKAN_SUPERVISOR_B=
DHADKAN_SUPERVISOR_C=
# Demo mode: the judge's number (can also be typed in the dashboard)
DHADKAN_DEMO_TO=

# 1 = build and log every message but send nothing, even with keys set (rehearsals, recordings)
DHADKAN_DRY_RUN=

# WhatsApp language per factory: hi, mr, gu, en or hi_latn (Hindi in Roman script). Default: the factory's.
DHADKAN_LANG_A=
DHADKAN_LANG_B=
DHADKAN_LANG_C=

# 1 = send approved templates alert_watch / alert_repair / alert_stop / daily_digest (docs/WHATSAPP_TEMPLATES.md)
WA_TEMPLATES=

# The factory's own mechanic (gets the WhatsApp job after the owner replies 1) and its language
DHADKAN_MECHANIC_A=
DHADKAN_MECHANIC_B=
DHADKAN_MECHANIC_C=
DHADKAN_LANG_MECHANIC_A=

# Real WhatsApp flow (server/whatsapp.py, server/wa_agent.py, server/factory/flow.py) via the Twilio sandbox.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WA_FROM=whatsapp:+17372508034
OWNER_PHONE=whatsapp:+91XXXXXXXXXX
# npm run demo opens an ngrok tunnel and sets PUBLIC_BASE_URL when this is set.
NGROK_AUTHTOKEN=
# Template first: Twilio trial senders refuse free text (21654). The template's ContentSid (HX...) from the
# Try WhatsApp page, and its variables: {short} = short alert, {time} = now. The full alert follows as the
# reply when the person answers. TWILIO_TEMPLATE_FIRST=1 skips the free-text attempt.
TWILIO_CONTENT_SID=
TWILIO_CONTENT_VARS={"1": "{short}", "2": "{time}"}
TWILIO_TEMPLATE_FIRST=

# Command centre agent on WhatsApp (server/cc_whatsapp.py): its owner/supervisor messages, booking questions
# (owner replies 1 / 2) and the mechanic's job go out through the Twilio settings above. Off unless 1;
# DHADKAN_DRY_RUN=1 still stops every real send. At most 12 messages per phone per hour.
DHADKAN_CC_WHATSAPP=

# Optional: send WhatsApp through wabot.shop instead of Twilio (Twilio stays the fallback).
# Client ID / Secret from app.wabot.shop -> Settings -> Developer -> Client Settings. Number must be connected first.
# WHATSAPP_PROVIDER=wabot
# WABOT_CLIENT_ID=
# WABOT_CLIENT_SECRET=
# WABOT_PHONE_ID=        # optional; read from your account if empty

# Claude (Anthropic API): reads uploaded warranty cards / insurance policies (PDF or photo), the agent, the
# second look at an alert. Without it everything still works offline with rules (text and text-PDF papers).
# ANTHROPIC_API_KEY above also turns this on.
# 0 = don't index the sample papers in data/sample_docs/ for the demo machines (Loom 1, Pump 1)
DHADKAN_SAMPLE_DOCS=
# any technician by id (data/demo/technicians.json), e.g. DHADKAN_TECH_T2=+91...; the job goes to this number
DHADKAN_TECH_T1=
DHADKAN_TECH_T2=
# hours a mechanic has to answer a job before it counts as a no-show (re-plan); wall clock
DHADKAN_MECHANIC_REPLY_HOURS=4
# 0 = the agent's and the planner's owner messages and the mechanic's job stay internal (no WhatsApp)
DHADKAN_AGENT_WHATSAPP=
# voice notes on alerts and digests (server/voice.py; .\dev.ps1 voice-models once). 0 = text only
DHADKAN_VOICE=
# engine per language, overriding the evaluated pick (docs/runs/tts_*.json): piper-hi-priyamvada, mms-hi, mms-mr, ...
DHADKAN_TTS_HI=
DHADKAN_TTS_MR=
DHADKAN_TTS_GU=
# 0 = always the template reply to an owner's chat (otherwise a Granite reply is used only when it is grounded,
# passes the Guardian and is in the owner's language; which one was used is logged as reply_source)
DHADKAN_GRANITE_REPLIES=

# The LLM: IBM Granite on a local Ollama server (server/provider.py). No API key, no cloud call, ₹0 per token.
#   ollama pull ibm/granite4.2:8b-q3_K_M     (chat + tool calling)
#   ollama pull granite-embedding            (knowledge-base retrieval)
# The planner (server/planner): Granite proposes the tool calls on every event; the approval gate, grounding check
# and audit stay in code. Ollama not running (or DHADKAN_PLANNER=0): the fixed plan runs instead.
OLLAMA_URL=http://127.0.0.1:11434
DHADKAN_MODEL=ibm/granite4.2:8b-q3_K_M
DHADKAN_EMBED_MODEL=granite-embedding
# context window asked of Ollama, seconds allowed per call (CPU-only laptops are slow), 1 = Granite thinking on "high" tiers
DHADKAN_NUM_CTX=8192
DHADKAN_LLM_TIMEOUT_S=180
DHADKAN_GRANITE_THINK=
# events the local model leaves to the rules (bookkeeping; an alarm must not wait behind them on a CPU)
DHADKAN_LLM_SKIP_EVENTS=daily_tick,network_restored
# 0 = never call a model (planner and owner agent use their rules)
DHADKAN_LLM=
DHADKAN_PLANNER=
# Model per kind of event (empty = DHADKAN_MODEL): routine (acks, daily tick), plan (alarms, mechanics, parts),
# diagnose (unsure, failed repair, voice). Any model you have pulled in Ollama.
DHADKAN_MODEL_ROUTINE=
DHADKAN_MODEL_PLAN=
DHADKAN_MODEL_DIAGNOSE=
# ₹ per million tokens for the local model (electricity, hardware); empty = 0
DHADKAN_LOCAL_INR_PER_MTOK=
# Bounds: model calls and tokens per event, rupees of LLM cost per case (then the fixed plan takes over)
DHADKAN_PLANNER_MAX_TURNS=6
DHADKAN_PLANNER_MAX_TOKENS=40000
DHADKAN_PLANNER_CASE_CAP_INR=50
